GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Core production services
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
REDIS_URL=redis://localhost:6379/0

# Optional local LLM
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=120

# Meta WhatsApp Cloud API webhook verification/signing
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
WHATSAPP_APP_SECRET=replace-with-your-meta-app-secret
WHATSAPP_BRAND=vitalis-wellness

# Meta Instagram Messaging webhook verification/signing
INSTAGRAM_VERIFY_TOKEN=replace-with-a-random-verification-token
INSTAGRAM_APP_SECRET=replace-with-your-meta-app-secret
INSTAGRAM_BRAND=hair-studio

# Inbound email
EMAIL_BRAND=vitalis-wellness

# Local-only testing. Keep false in production.
ALLOW_UNSIGNED_WEBHOOKS=false

# Langfuse Cloud (optional observability)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_DEBUG=False
